<div class="pagination">

  <% if current_page > 1 %>
    <%= link_to "Previous", resource_index_path(resource, page: current_page - 1) %>
  <% end %>

  <% if start_page > 1 %>
    <%= link_to 1, resource_index_path(resource, page: 1) %>
    ...
  <% end %>

  <% (start_page..end_page).each do |page| %>

    <% if page == current_page %>
      <span class="current""><%= page %></span>
    <% else %>
      <%= link_to page, resource_index_path(resource, page: page), style: "margin: 0 5px;" %>
    <% end %>

  <% end %>

  <% if end_page < total_pages %>
    ...
    <%= link_to total_pages, resource_index_path(resource, page: total_pages) %>
  <% end %>

  <% if current_page < total_pages %>
    <%= link_to "Next", resource_index_path(resource, page: current_page + 1) %>
  <% end %>

</div>